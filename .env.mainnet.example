# ═════════════════════════════════════════════════════════════════════════════
# Parcis Protocol — Production Mainnet Environment Template (.env.mainnet.example)
# Target: Arc Mainnet (Chain ID: 5042)
# Domain: parcis.app
# ═════════════════════════════════════════════════════════════════════════════

# ── Active Network Selector ──
VITE_NETWORK=mainnet
NETWORK=mainnet

# ─── Frontend (Vite) — Arc Mainnet Deployed Contract Addresses ───
VITE_LINKS_CONTRACT=0xddB356b2cDd210C717dDc6ACCB50e4825dC290e0
VITE_ARCSAFE_CONTRACT=0x7BD84F1EDA677c98217F590560E8C0577Efba809
VITE_STREAMS_CONTRACT=0xe6775F130F61d9d2e3E93Dad2e6d971788D36557
VITE_DEV_REGISTRY_CONTRACT=0x553f697C3a72e91A4cBa16D807DB5015275B0Cc1

# ─── Arc Mainnet Network Parameters ───
VITE_CHAIN_ID=5042
VITE_CHAIN_NAME="Arc"
VITE_RPC_URL=https://rpc.mainnet.arc.io
VITE_EXPLORER=https://explorer.arc.io
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ─── Reown / WalletConnect Project ID ───
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# ─── Protocol Fees & Governance ───
VITE_PREMIUM_SLUG_FEE=0.5
VITE_MIN_ARBITER_STAKE=10
VITE_ARBITER_FEE_PERCENT=0.5
VITE_PLATFORM_FEE_PERCENT=0.25

# ─── Circle Web3 Credentials ───
VITE_CIRCLE_KIT_KEY=your_circle_kit_key
VITE_CIRCLE_CLIENT_KEY=your_circle_client_key
VITE_CIRCLE_API_KEY=your_circle_api_key

CIRCLE_KIT_KEY=your_circle_kit_key
CIRCLE_CLIENT_KEY=your_circle_client_key
CIRCLE_API_KEY=your_circle_api_key

# ─── Admin Access Control ───
VITE_ADMIN_ROUTE_PATH=parcis-ops-9842x
VITE_ADMIN_WALLETS=0xyour_admin_wallet_here

# ─── Backend / API / Serverless (Vercel Production) ───
RPC_URL=https://rpc.mainnet.arc.io
CHAIN_ID=5042
LINKS_CONTRACT=0xddB356b2cDd210C717dDc6ACCB50e4825dC290e0
ARCSAFE_CONTRACT=0x7BD84F1EDA677c98217F590560E8C0577Efba809
STREAMS_CONTRACT=0xe6775F130F61d9d2e3E93Dad2e6d971788D36557
DEV_REGISTRY_CONTRACT=0x553f697C3a72e91A4cBa16D807DB5015275B0Cc1

# Gas Relayer / Sponsor private key (funds free link sponsorship on Arc)
SPONSOR_PRIVATE_KEY=your_sponsor_private_key_without_0x
ADMIN_PRIVATE_KEY=your_sponsor_private_key_without_0x

# ─── Smart Contract Deployment (Local Terminal Only - NEVER commit to Git!) ───
MAINNET_DEPLOYER_PRIVATE_KEY=your_offline_mainnet_deployer_key_without_0x
DEPLOYER_PRIVATE_KEY=your_offline_mainnet_deployer_key_without_0x