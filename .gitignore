# ═══ PayArc .gitignore ═══

# ── Environment / Secrets (NEVER commit these) ──
.env
.env.local
.env.*.local
api/.env

# ── Node modules ──
node_modules/
.pnp
.pnp.js

# ── Build output ──
dist/
dist-ssr/

# ── Vite cache ──
.vite/

# ── Editor / OS ──
.DS_Store
Thumbs.db
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
.vscode/
*.swp
*.swo

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vercel ──
.vercel/

# ── Optional: local test artifacts ──
coverage/
*.local
.helm-diag/
artifacts/
cache/
locals/